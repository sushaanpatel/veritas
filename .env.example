# AWS Bedrock Configuration
ANTHROPIC_API_KEY=
# Optional: override default model (claude-3-5-sonnet-20241022)
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Tavily Search API Configuration
TAVILY_API_KEY=your-tavily-api-key

# LangSmith Configuration (Optional - for tracing and debugging)
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=multi-agent-research

# Research Configuration
MAX_SOURCES=20
SEARCH_DEPTH=advanced
CONFIDENCE_THRESHOLD=0.7

# Available AWS Bedrock Claude Models:
# - anthropic.claude-3-5-sonnet-20241022-v2:0 (recommended - best balance)
# - anthropic.claude-3-haiku-20240307-v1:0 (faster, cheaper)
# - anthropic.claude-3-opus-20240229-v1:0 (most capable, slower, expensive)
